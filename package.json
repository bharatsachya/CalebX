{
  "name": "calebx-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter \"*\" build",
    "bot:start": "bun --cwd packages/telegram-bot start",
    "bot:telegram": "bun --cwd packages/telegram-bot start",
    "bot:whatsapp": "bun --cwd packages/whatsapp-bot start",
    "bot:form": "bun --cwd packages/telegram-bot start:form",
    "import": "bun --cwd packages/directory-import import",
    "db:migrate": "bun --cwd packages/db migrate",
    "sheets:init": "bun --cwd packages/sheets init",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "lint": "echo 'No eslint configured yet'",
    "commit:validate": "bun run scripts/commit-validate.ts",
    "push:validate": "bun run scripts/push-validate.ts",
    "deploy:azure": "bun run scripts/deploy-azure.ts",
    "azure:stop": "bun run scripts/stop-azure.ts",
    "azure:start": "bun run scripts/start-azure.ts",
    "azure:destroy": "bun run scripts/destroy-azure.ts",
    "prepare": "husky",
    "import:images": "bun --cwd packages/directory-import import:images",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "graph:schema": "bun --cwd packages/graph schema",
    "trace:view": "bun --cwd packages/trace view",
    "worker:agent": "bun --cwd packages/queue worker:agent",
    "worker:ingest": "bun --cwd packages/queue worker:ingest",
    "worker:dispatch": "bun --cwd packages/queue worker:dispatch"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.0.1",
    "gramio": "^0.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "ioredis": "^6.0.0",
    "neo4j-driver": "^6.2.0"
  }
}
