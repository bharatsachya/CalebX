# CalebX environment. Copy to .env for local Bun scripts (e.g. `bun run db:migrate`).
# In production these are Cloudflare Worker secrets/vars — see packages/telegram-bot/
# wrangler.jsonc (vars) and `wrangler secret put <NAME>` (secrets).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Long random string echoed back by Telegram in the webhook secret-token header.
# Must match the secret_token you pass to setWebhook.
TELEGRAM_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# --- Neo4j Aura (HTTP Query API — Bolt/TCP is unavailable on Workers) ---
# URL shape: https://<dbid>.databases.neo4j.io/db/neo4j/query/v2
NEO4J_HTTP_URL=https://YOUR_INSTANCE.databases.neo4j.io/db/neo4j/query/v2
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD_HERE

# --- LLM: Google AI Studio (Gemini) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional override; defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- Tuning (optional — shown with defaults) ---
# MAX_DAILY_MESSAGES=20
# MIN_MATCH_SCORE=3
# SUMMARIZE_MIN_TURNS=4
