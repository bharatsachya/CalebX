# Copy this file to `.env` at the repo root and fill in the values.
# `.env` is gitignored. Never commit real credentials.

# --- Telegram (packages/telegram-bot) ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# --- Agent (packages/agent) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# Optional. Defaults to meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Optional. Vision model for `import:images --engine vision`. Must accept image
# input. A `:free` endpoint generally lets the provider train on what it sees —
# think before pointing it at biodata photos and phone numbers.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# https://app.mem0.ai — long-term persona memory.
MEM0_API_KEY=YOUR_MEM0_API_KEY_HERE

# --- WhatsApp (packages/whatsapp-bot) ---
# Meta App Dashboard > WhatsApp > Configuration.
#
# Any string you invent; paste the same value into the Meta webhook config so
# Meta can prove it is talking to the right server during the GET handshake.
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN_HERE
# Meta App Dashboard > App settings > Basic > App secret.
# This — NOT the access token — is the HMAC key for X-Hub-Signature-256.
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET_HERE
# The test number's token expires after 24h. Create a System User token for anything real.
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN_HERE
# Meta App Dashboard > WhatsApp > API Setup > "Phone number ID" (NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID_HERE

# Optional — sensible defaults below.
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_GRAPH_BASE=https://graph.facebook.com
WHATSAPP_PORT=8787
WHATSAPP_WEBHOOK_PATH=/webhook
# Webhook retries older than this are dropped. Guards against Meta replaying an
# event days later and us answering outside the 24h customer-service window.
WHATSAPP_MAX_MESSAGE_AGE_SECONDS=300
# true => log outbound payloads instead of calling Graph. Lets you exercise the
# full consent/onboarding/agent flow with no Meta account at all.
WHATSAPP_DRY_RUN=false

# --- Local state (optional overrides, CALEBX/telegram-bot only) ---
# Default to <repo>/.data/*.json
# CONSENT_STORE_PATH=
# ONBOARDING_STORE_PATH=

# --- Matchmaking database (packages/db, packages/whatsapp-bot) ---
# A separate product sharing this monorepo. One Postgres database.
# `bun run db:migrate` applies the schema.
DATABASE_URL=postgres://localhost:5432/calebx_matchmaking

# --- Google Sheets (packages/sheets) ---
# Backs the form-bot prototype (`bun run bot:form`) — the same matchmaking
# fields as the Postgres schema, in a spreadsheet you curate by hand.
# `bun run sheets:init` creates the tabs and header rows.
#
# The long id in the sheet's URL, between /d/ and /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_GOOGLE_SHEETS_SPREADSHEET_ID_HERE
# Google Cloud > IAM > Service Accounts. Enable the Google Sheets API, then
# SHARE THE SPREADSHEET WITH THIS ADDRESS AS EDITOR — skipping that is the
# cause of almost every 403 here.
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_GOOGLE_SERVICE_ACCOUNT_EMAIL_HERE
# The `private_key` field of the service account's JSON key. Keep the quotes and
# the literal \n escapes; the config unescapes them before signing.
GOOGLE_PRIVATE_KEY="YOUR_GOOGLE_PRIVATE_KEY_HERE"

# --- Azure Deployment (scripts/deploy-azure.ts) ---
# Optional overrides for Azure Container Apps deployment.
RESOURCE_GROUP=rg-calebx-centralindia
LOCATION=centralindia
ENVIRONMENT_NAME=cae-calebx-centralindia
APP_NAME=calebx-form-bot

