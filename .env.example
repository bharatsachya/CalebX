# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Neo4j — bring your own instance (e.g. Aura free tier: neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD_HERE

# LLM — OpenRouter (free-tier model by default)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# Optional override; defaults to a free model
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Tuning (optional — shown with defaults)
# MAX_DAILY_MESSAGES=20
# MIN_MATCH_SCORE=3
# SUMMARIZE_MIN_TURNS=4
